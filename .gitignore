# ---------------------------------------------------------------------------
# Xcode / Swift
# ---------------------------------------------------------------------------
build/
DerivedData/
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
*.xcodeproj/project.xcworkspace/xcuserdata/
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# XcodeGen generates the .xcodeproj from project.yml.
# The generated project is intentionally NOT committed so that the repository
# stays free of machine-specific absolute paths.
ProxyTunnel.xcodeproj/

# Swift Package Manager
.swiftpm/
Package.resolved

# ---------------------------------------------------------------------------
# Secrets / signing material.  NEVER commit any of these.
# ---------------------------------------------------------------------------
*.p12
*.pfx
*.cer
*.certSigningRequest
*.csr
*.mobileprovision
*.provisionprofile
*.p8
*.pem
*.key
AuthKey_*.p8
secrets/
signing/
fastlane/report.xml

# ---------------------------------------------------------------------------
# Android / Gradle
# ---------------------------------------------------------------------------
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.kotlin/
# The tunnel engine AAR is fetched and checksum-verified by
# android/scripts/fetch-native-libs.sh, so the binary is never committed.
android/app/libs/
*.aar
*.apk
*.aab
*.jks
*.keystore

# ---------------------------------------------------------------------------
# Local build / test output
# ---------------------------------------------------------------------------
artifacts/
*.log
!docs/**/*.log

# ---------------------------------------------------------------------------
